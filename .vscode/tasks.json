// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build:ui",
			"type": "npm",
			"script": "build",
			"path": "packages/ui",
			"problemMatcher": []
		},
		{
			"label": "build:extension",
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
			}
		},
		{
			"label": "build:all",
			"dependsOrder": "sequence",
			"dependsOn": [
				"build:ui",
				"build:extension"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}